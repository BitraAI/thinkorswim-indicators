def Time1345 = SecondsFromTime(1330) == 0;
AddVerticalLine(Time1345, "Moderate", Color.WHITE, Curve.SHORT_DASH);
def Time1450 = SecondsFromTime(1450) == 0;
AddVerticalLine(Time1450, "Very High", Color.WHITE, Curve.SHORT_DASH);

# Squeeze
def sqzLength = 20;
def lowDev = 1.0;
def midDev = 1.5;
def highDev = 2.0;
#def avgPrice = (open + close) / 2;

# Bolinger Bands
def bbDev = StDev(close, sqzLength);
def midLine = Average(close, sqzLength);
def upperBand = midLine + highDev * bbDev;

# Keltner Channels
def ATR = Average(TrueRange(high, close, low), sqzLength);
def highShift = highDev * ATR;
def midShift = midDev * ATR;
def lowShift = lowDev * ATR;
def highChannel = midLine + highShift;
def midChannel = midLine + midShift;
def lowChannel = midLine + lowShift;

plot sqzRed = if upperBand < midChannel and upperBand > lowChannel then zeroLine else Double.NaN;
sqzRed.SetPaintingStrategy(PaintingStrategy.POINTS);
sqzRed.AssignValueColor(Color.RED);
sqzRed.SetLineWeight(3);
plot sqzBlack = if upperBand < highChannel and upperBand > midChannel then zeroLIne else Double.NaN;
sqzBlack.SetPaintingStrategy(PaintingStrategy.POINTS);
sqzBlack.AssignValueColor(Color.BLACK);
sqzBlack.SetLineWeight(3);
plot sqzOrange = if upperBand < lowChannel then zeroLine else Double.NaN;
sqzOrange.SetPaintingStrategy(PaintingStrategy.POINTS);
sqzOrange.AssignValueColor(Color.ORANGE);
sqzOrange.SetLineWeight(3);
